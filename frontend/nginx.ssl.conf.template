# ==============================================================================
# VAYRO — HTTPS-Ready Nginx Configuration Template
# Domains: vayro.com, www.vayro.com, localhost
# Note: For production container deployments (e.g. Cloud Run, standalone VM),
# this template terminates TLS or passes through depending on deployment target.
# ==============================================================================

# Rate limiting zone for authentication endpoints (10MB memory, 15 requests/minute per client IP)
limit_req_zone $binary_remote_addr zone=vayro_auth_limit:10m rate=15r/m;

# ------------------------------------------------------------------------------
# HTTP SERVER (Port 8080 / 80)
# Handles ACME challenge for Let's Encrypt, domain redirects, and local dev fallback
# ------------------------------------------------------------------------------
server {
    listen 8080;
    server_name vayro.com www.vayro.com localhost;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Let's Encrypt / Certbot ACME HTTP-01 challenge directory
    # Volume mounted in production from /var/www/certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Health check endpoint for Cloud Run and load balancers
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'OK';
    }

    # Conditional HTTPS redirection:
    # Only redirect production domains to HTTPS.
    # Requests to localhost or internal IP addresses are served directly over HTTP,
    # preserving local development and Docker internal health checks without interruption.
    if ($host ~* ^(vayro\.com|www\.vayro\.com)$) {
        return 301 https://$host$request_uri;
    }

    # Standard security headers (HSTS deliberately omitted on HTTP)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Local development & unencrypted fallback API proxy
    location /api/auth/ {
        limit_req zone=vayro_auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://api-gateway:8080/api/auth/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://api-gateway:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:ico|css|js|gif|jpe?g|png|webp|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

# ------------------------------------------------------------------------------
# HTTPS SERVER (Port 8443 / 443)
# Active when SSL certificates are provisioned and mounted into container
# ------------------------------------------------------------------------------
server {
    listen 8443 ssl;
    http2 on;
    server_name vayro.com www.vayro.com;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # SSL Certificate & Private Key paths
    # In production Docker Compose, volume-mount the entire /etc/letsencrypt directory read-only:
    #   - /etc/letsencrypt:/etc/letsencrypt:ro
    ssl_certificate /etc/letsencrypt/live/vayro.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vayro.com/privkey.pem;

    # Modern TLS Protocol & Cipher configuration (Mozilla Modern / Intermediate standard)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # SSL Session Optimization
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --------------------------------------------------------------------------
    # CRITICAL SECURITY RULE: HSTS (HTTP Strict Transport Security)
    # WARNING: DO NOT UNCOMMENT THIS HEADER UNTIL HTTPS HAS BEEN FULLY VERIFIED
    # IN PRODUCTION WITH VALID SIGNED CERTIFICATES.
    # Enabling HSTS prematurely or with invalid certs causes browsers to permanently
    # reject connection with no user bypass.
    #
    # When HTTPS is verified working:
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    # --------------------------------------------------------------------------

    # Rate-limited authentication API proxy
    location /api/auth/ {
        limit_req zone=vayro_auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://api-gateway:8080/api/auth/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # General API proxy
    location /api/ {
        proxy_pass http://api-gateway:8080/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets caching
    location ~* \.(?:ico|css|js|gif|jpe?g|png|webp|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # Error handling
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
