# VAYRO Frontend Environment Configuration Example
VITE_APP_NAME=VAYRO
VITE_APP_URL=https://vayro.com
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=718836314167-kekvffi6ugr8s6gfg6ds00qb190ee12s.apps.googleusercontent.com

# ========================================================
# Google OAuth 2.0 Backend Configuration
# ========================================================
GOOGLE_CLIENT_ID=718836314167-kekvffi6ugr8s6gfg6ds00qb190ee12s.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ========================================================
# VAYRO Microservices JWT Secret (256-bit Base64 / Hex Key)
# ========================================================
JWT_SECRET=your_256_bit_base64_jwt_secret_here

# ========================================================
# VAYRO Backend Notification Service Environment Variables
# ========================================================
# Official Sender Identity: VAYRO Notifications <vayro.notifications@gmail.com>
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=vayro.notifications@gmail.com
# MAIL_PASSWORD=your_16_character_google_app_password_here
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM_NAME=VAYRO
# MAIL_FROM_ADDRESS=vayro.notifications@gmail.com
# NOTIFICATION_EMAIL_ENABLED=false
# ADMIN_NOTIFICATION_EMAIL=admin@vayro.com

# ========================================================
# VAYRO Database Configuration
# ========================================================
# Option A: Supabase PostgreSQL Session Pooler (Cloud Testing & Production)
# Required by docker-compose.yml and docker-compose.supabase.yml
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.lgpuulmsdogxzsyoqwdk
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_DB_SSLMODE=?sslmode=require

# Compatibility fallback variables for bare-metal execution
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DOCKER_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.lgpuulmsdogxzsyoqwdk
DB_PASSWORD=your_supabase_db_password_here
DB_SSLMODE=?sslmode=require

# Option B: Local PostgreSQL (Local Development via docker-compose.local.yml)
# LOCAL_DB_HOST=host.docker.internal
# LOCAL_DB_PORT=5432
# LOCAL_DB_NAME=vayro_users
# LOCAL_DB_USERNAME=postgres
# LOCAL_DB_PASSWORD=
# LOCAL_DDL_AUTO=update
# Bare-metal local variables:
# DB_HOST=localhost
# DOCKER_DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_NAME=vayro_users
# DB_USERNAME=your_local_postgres_username
# DB_PASSWORD=
# DB_SSLMODE=
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vayro_users

# ========================================================
# VAYRO Admin Bootstrap Configuration (Disabled by default in production)
# ========================================================
ADMIN_BOOTSTRAP_ENABLED=false
